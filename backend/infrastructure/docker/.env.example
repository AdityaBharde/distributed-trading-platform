# Copy to .env and set your own values:  cp .env.example .env
# .env is git-ignored. Docker Compose reads it automatically from this folder.

# Postgres superuser password (also used by trading-service)
POSTGRES_PASSWORD=change_me

# Shared secret between the Next.js server (BFF) and the gateway, used to forward the browser's IP for rate limiting.
# Any long random string; use the same value in frontend/quantanatara/.env.local
BFF_SHARED_SECRET=change_me_too
