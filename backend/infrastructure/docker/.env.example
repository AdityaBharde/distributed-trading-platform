# Copy to .env and set your own values:  cp .env.example .env
# .env is git-ignored. Docker Compose reads it automatically from this folder.

# Postgres superuser password (also used by trading-service)
POSTGRES_PASSWORD=change_me

# Password of the 'keycloak' database role
KEYCLOAK_DB_PASSWORD=change_me

# Keycloak admin console login (http://localhost:8180)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
